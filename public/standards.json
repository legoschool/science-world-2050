{
 "standards": {
  "6과13-01": {
   "short": "태양 고도, 그림자 길이, 기온의 관계",
   "text": "태양 고도 측정기로 하루 동안 태양 고도, 그림자 길이, 기온을 측정하여 이들의 관계를 찾을 수 있다.",
   "region": "R1"
  },
  "6과13-02": {
   "short": "계절에 따른 태양의 남중 고도와 낮의 길이",
   "text": "계절에 따른 태양의 남중 고도와 낮의 길이 사이의 관계를 자료에 근거하여 추론할 수 있다.",
   "region": "R1"
  },
  "6과13-03": {
   "short": "계절이 바뀌는 까닭(기울어진 자전축과 공전)",
   "text": "계절 변화의 원인을 지구의 자전축이 기울어진 채 공전하는 것으로 설명할 수 있다.",
   "region": "R1"
  },
  "6과14-01": {
   "short": "성질이 달라지는 변화와 그대로인 변화",
   "text": "물질의 성질이 달라지는 변화와 달라지지 않는 변화를 관찰하여 비교할 수 있다.",
   "region": "R2"
  },
  "6과14-02": {
   "short": "연소할 때 나타나는 현상과 연소의 조건",
   "text": "물질이 연소할 때 나타나는 공통적인 현상을 관찰하고, 연소의 조건을 찾을 수 있다.",
   "region": "R2"
  },
  "6과14-03": {
   "short": "연소 전과 후 물질의 변화",
   "text": "연소 전과 후의 물질을 비교하여 연소 과정에서 물질의 성질이 달라짐을 설명할 수 있다.",
   "region": "R2"
  },
  "6과14-04": {
   "short": "연소로 생기는 물질의 피해와 해결책",
   "text": "연소 과정에서 생성되는 물질로 인한 생태계의 피해 사례를 수집하고 분석하여 해결책을 제안하고 공유할 수 있다.",
   "region": "R2"
  },
  "6과15-01": {
   "short": "전구에 불이 켜지는 전기 회로",
   "text": "전지와 전구, 전선을 연결하여 전구에 불을 켜 보고, 불이 켜지는 전기 회로의 특징을 말할 수 있다.",
   "region": "R3"
  },
  "6과15-02": {
   "short": "전지 1개와 전지 2개 직렬연결 비교",
   "text": "전지 1개를 연결한 전기 회로와 전지 2개를 직렬연결한 전기 회로의 특징을 비교할 수 있다.",
   "region": "R3"
  },
  "6과15-03": {
   "short": "전자석의 성질과 쓰임",
   "text": "전자석을 만들어 전자석의 성질을 탐색하고 전자석이 사용되는 예를 조사할 수 있다.",
   "region": "R3"
  },
  "6과15-04": {
   "short": "전기를 아끼고 안전하게 쓰는 방법",
   "text": "전기를 효율적이고 안전하게 사용하는 방법을 조사하여 실천 계획을 세우고 일상생활에서 실천할 수 있다.",
   "region": "R3"
  },
  "6과16-01": {
   "short": "미래 사회 문제와 과학의 쓰임",
   "text": "미래 사회에 일어날 수 있는 문제를 조사하고, 문제를 해결하는 데 과학이 기여할 수 있는 방법을 토의할 수 있다.",
   "region": "R4"
  },
  "6과16-02": {
   "short": "과학과 관련된 진로",
   "text": "다양한 진로가 과학과 관련됨을 알고, 자신의 진로를 과학과 관련지어 설명할 수 있다.",
   "region": "R4"
  },
  "6과04-01": {
   "short": "뼈와 근육이 몸을 움직이는 원리",
   "text": "뼈와 근육의 생김새를 관찰하고 모형을 만들어 몸이 움직이는 원리를 설명할 수 있다.",
   "region": "R5"
  },
  "6과04-02": {
   "short": "소화, 순환, 호흡, 배설 기관이 함께 하는 일",
   "text": "소화, 순환, 호흡, 배설기관의 구조와 기능을 알아보고, 우리 몸의 여러 기관이 서로 관련되어 있음을 설명할 수 있다.",
   "region": "R5"
  },
  "6과04-03": {
   "short": "기관과 관련된 질병과 건강한 생활 방식",
   "text": "우리 몸의 여러 기관과 관련된 질병을 조사하고, 건강을 유지하기 위한 생활 방식을 실천할 수 있다.",
   "region": "R5"
  },
  "6과02-01": {
   "short": "물체를 보는 데 필요한 빛",
   "text": "물체를 보기 위해서 빛이 있어야 함을 알고, 빛의 성질에 대해 흥미를 느낄 수 있다.",
   "region": "R5"
  },
  "6과02-02": {
   "short": "빛의 직진, 반사, 굴절",
   "text": "빛이 나아가는 현상을 관찰하여 빛이 직진, 반사, 굴절하는 성질이 있음을 말할 수 있다.",
   "region": "R5"
  },
  "6과02-03": {
   "short": "거울과 렌즈의 쓰임과 장치 만들기",
   "text": "거울과 렌즈의 쓰임새를 조사하고 거울이나 렌즈를 이용한 장치를 창의적으로 만들 수 있다.",
   "region": "R5"
  },
  "6과08-01": {
   "short": "생활 속 자원과 자원의 유한함",
   "text": "우리가 생활에서 이용하는 다양한 자원을 조사하고, 자원의 유한함을 설명할 수 있다.",
   "region": "R5"
  },
  "6과08-02": {
   "short": "재생에너지와 지속가능한 에너지 이용",
   "text": "재생에너지의 종류를 조사하고, 에너지를 지속가능하게 이용하는 방법에 관심을 갖는다.",
   "region": "R5"
  },
  "6과08-03": {
   "short": "자원과 에너지의 효율적인 이용과 실천",
   "text": "자원과 에너지의 효율적인 이용 방법에 대해 탐색하고, 생활 속에서 실천할 수 있는 다양한 사례를 공유할 수 있다.",
   "region": "R5"
  }
 },
